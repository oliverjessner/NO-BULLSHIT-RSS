#!/bin/sh

set -eu

# Resolve symlinks so this launcher keeps working when linked into /usr/local/bin.
SOURCE=$0
while [ -h "$SOURCE" ]; do
    SOURCE_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")" && pwd)
    LINK_TARGET=$(readlink "$SOURCE")
    case "$LINK_TARGET" in
        /*) SOURCE=$LINK_TARGET ;;
        *) SOURCE=$SOURCE_DIR/$LINK_TARGET ;;
    esac
done

LAUNCHER_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")" && pwd)
RESOURCES_DIR=$(CDPATH= cd -- "$LAUNCHER_DIR/.." && pwd)
CONTENTS_DIR=$(CDPATH= cd -- "$RESOURCES_DIR/.." && pwd)
NODE_BIN="$CONTENTS_DIR/MacOS/rss-node"
CLI_ENTRY="$RESOURCES_DIR/runtime/cli/no-bullshit-rss.js"

if [ ! -x "$NODE_BIN" ]; then
    printf 'Error: bundled Node runtime not found at %s\n' "$NODE_BIN" >&2
    exit 1
fi

if [ ! -f "$CLI_ENTRY" ]; then
    printf 'Error: NO BULLSHIT RSS CLI not found at %s\n' "$CLI_ENTRY" >&2
    exit 1
fi

unset NODE_OPTIONS NODE_PATH
exec "$NODE_BIN" "$CLI_ENTRY" "$@"
