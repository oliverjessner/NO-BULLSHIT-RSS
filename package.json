{
    "name": "no-bullshit-rss",
    "version": "1.1.1",
    "type": "module",
    "description": "RSS-based news aggregator",
    "main": "electron/main.cjs",
    "bin": {
        "no-bullshit-rss": "./cli/no-bullshit-rss.js"
    },
    "author": {
        "name": "oliverjessner",
        "url": "https://oliverjessner.at"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oliverjessner/NO-BULLSHIT-RSS/"
    },
    "homepage": "https://oliverjessner.at/NO-BULLSHIT-RSS",
    "scripts": {
        "start": "node backend/server.js",
        "electron": "electron .",
        "dev": "electron .",
        "dev:server": "node --watch backend/server.js",
        "test": "node --test backend/database/migrations.test.js backend/middleware/validate-request.test.js backend/services/topics.test.js backend/services/topics-persistence.test.js backend/services/bullshit-rules.test.js backend/services/article-import.test.js backend/services/digest-periods.test.js backend/services/digest-store.test.js backend/routes/articles-triage.test.js backend/routes/feeds.test.js cli/*.test.js public/js/utils/*.test.js",
        "test:topics": "node --test backend/services/topics.test.js",
        "db:init": "node scripts/init-db.js",
        "db:backup": "node scripts/backup-db.js",
        "db:report": "node scripts/database-report.js",
        "benchmark:digest": "node scripts/benchmark-digest.js 8000",
        "dist:mac": "electron-rebuild -f -w @vscode/sqlite3 && electron-builder --mac dmg --arm64",
        "dist:win": "electron-builder --win nsis --x64",
        "dist:linux": "electron-builder --linux AppImage --x64",
        "dist:all": "electron-rebuild -f -w @vscode/sqlite3 && electron-builder --mac --win --linux",
        "dist:all:workaround": "PYTHON=/opt/homebrew/opt/python@3.11/bin/python3.11 CSC_IDENTITY_AUTO_DISCOVERY=false npm run dist:all",
        "build:all": "npm run dist:all:workaround",
        "publish": "bash publish.sh"
    },
    "dependencies": {
        "@biu/simhash": "^0.1.1",
        "@vscode/sqlite3": "5.1.14-vscode",
        "ajv": "^8.20.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "iconv-lite": "^0.7.3",
        "json-rules-engine": "^7.3.1",
        "rss-parser": "^3.13.0"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.4",
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "directories": {
            "output": "electron/dist",
            "buildResources": "electron/build"
        },
        "afterPack": "scripts/afterPack-adhoc-sign.cjs",
        "appId": "com.oliverjessner.no-bullshit-rss",
        "productName": "NO BULLSHIT RSS",
        "files": [
            "electron/**",
            "!electron/dist/**",
            "!electron/package/**",
            "cli/**",
            "backend/**",
            "migrations/**",
            "public/**",
            "backend/database/**",
            "scripts/**",
            "scripts/sources.json",
            "package.json",
            "electron/build/icons/**",
            "node_modules/**"
        ],
        "icon": "electron/build/icons/icon.icns",
        "asarUnpack": [
            "node_modules/@vscode/sqlite3/**"
        ],
        "mac": {
            "icon": "electron/build/icons/icon.icns",
            "extraResources": [
                {
                    "from": "cli/launchers/macos/no-bullshit-rss",
                    "to": "bin/no-bullshit-rss"
                }
            ]
        }
    }
}
