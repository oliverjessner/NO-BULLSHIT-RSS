{
    "name": "no-bullshit-rss",
    "version": "1.6.0",
    "type": "module",
    "engines": {
        "node": ">=26.0.0"
    },
    "description": "RSS-based news aggregator",
    "bin": {
        "no-bullshit-rss": "./cli/no-bullshit-rss.js"
    },
    "author": {
        "name": "oliverjessner",
        "url": "https://oliverjessner.at"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oliverjessner/NO-BULLSHIT-RSS/"
    },
    "homepage": "https://oliverjessner.at/NO-BULLSHIT-RSS",
    "scripts": {
        "start": "node backend/server.js",
        "tauri": "tauri",
        "dev": "tauri dev --no-dev-server-wait",
        "desktop:prepare": "node scripts/prepare-desktop.js",
        "test:desktop": "node --test scripts/desktop.test.js && cargo test --manifest-path src-tauri/Cargo.toml",
        "dev:server": "node --watch backend/server.js",
        "test": "node --test backend/database/migrations.test.js backend/middleware/validate-request.test.js backend/services/topics.test.js backend/services/topics-persistence.test.js backend/services/bullshit-rules.test.js backend/services/article-import.test.js backend/services/logo.test.js backend/services/watchdogs.test.js backend/routes/watchdogs.test.js backend/services/statistics.test.js backend/services/digest-periods.test.js backend/services/digest-store.test.js backend/routes/articles-triage.test.js backend/routes/feeds.test.js backend/routes/digest-filters.test.js cli/*.test.js public/js/utils/*.test.js scripts/*.test.js",
        "test:watchdog-ui": "node scripts/test-watchdog-ui.js",
        "test:topics": "node --test backend/services/topics.test.js",
        "db:init": "node scripts/init-db.js",
        "db:backup": "node scripts/backup-db.js",
        "db:report": "node scripts/database-report.js",
        "benchmark:digest": "node scripts/benchmark-digest.js 8000",
        "screenshots": "node scripts/generate-mockups.js",
        "screenshots:install": "playwright install chromium",
        "dist:mac": "node scripts/build-desktop.js",
        "publish": "bash publish.sh",
        "publish:brew": "node scripts/publish-brew.js"
    },
    "dependencies": {
        "@biu/simhash": "^0.1.1",
        "@vscode/sqlite3": "5.1.14-vscode",
        "ajv": "^8.20.0",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "iconv-lite": "^0.7.3",
        "json-rules-engine": "^7.3.1",
        "fetchary": "2.0.7",
        "oj-designsystem": "0.2.0",
        "rss-parser": "^3.13.0"
    },
    "allowScripts": {
        "@vscode/sqlite3": true
    },
    "devDependencies": {
        "@tauri-apps/cli": "2.12.3",
        "playwright": "^1.64.1",
        "sharp": "^0.35.5"
    }
}
